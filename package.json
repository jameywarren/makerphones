{
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/starlight": "^0.40.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/schibsted-grotesk": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "astro": "^6.4.6",
    "sharp": "^0.35.1",
    "three": "^0.184.0"
  },
  "name": "makerphones",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "book": "astro build && node scripts/to-book/collect.mjs",
    "book:press": "astro build && node scripts/to-book/collect.mjs --press",
    "book:pdf": "npm run book && node scripts/to-book/render.mjs",
    "book:press:pdf": "npm run book:press && node scripts/to-book/render.mjs --press --cmyk",
    "book:press:pdfx": "npm run book:press && node scripts/to-book/render.mjs --press --pdfx",
    "book:parts": "node scripts/to-book/render-parts.mjs",
    "book:cover": "node scripts/to-book/render-cover.mjs --cmyk",
    "book:cover:ingram": "node scripts/to-book/render-cover.mjs --ingram --cmyk",
    "astro": "astro"
  },
  "devDependencies": {
    "pagedjs": "^0.4.3",
    "puppeteer-core": "^25.2.1"
  }
}
