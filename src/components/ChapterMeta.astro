---
/**
 * Chapter metadata row — difficulty, read time, prerequisites, related.
 *
 * Fed entirely by frontmatter (difficulty, read_time, prerequisites,
 * related). Rendered automatically beneath the page title via the
 * PageTitle override, so chapter Markdown stays pure and portable.
 * Prerequisite/related handles resolve to chapter titles at build time;
 * link text is always the chapter title, never "Chapter N".
 */
import { getCollection } from 'astro:content';

interface Props {
  difficulty?: 'Beginner' | 'Intermediate' | 'Advanced';
  readTime?: number;
  prerequisites?: string[];
  related?: string[];
}

const { difficulty, readTime, prerequisites = [], related = [] } = Astro.props;

const docs = await getCollection('docs');
const titleFor = (handle: string): string | undefined =>
  docs.find((d) => d.id === `learn/${handle}`)?.data.title;

// Frontmatter keeps every handle for portability, but only render links
// for chapters that exist — no 404 links to unwritten chapters.
const resolve = (handles: string[]) =>
  handles.flatMap((handle) => {
    const title = titleFor(handle);
    return title ? [{ handle, title }] : [];
  });

const prereqLinks = resolve(prerequisites);
const relatedLinks = resolve(related);

const hasContent =
  difficulty || readTime || prereqLinks.length > 0 || relatedLinks.length > 0;
---

{
  hasContent && (
    <div class="mp-chapter-meta not-content">
      {difficulty && (
        <span class="mp-difficulty" data-level={difficulty}>
          {difficulty}
        </span>
      )}
      {readTime && <span>{readTime} min read</span>}
      {prereqLinks.length > 0 && (
        <span>
          <span class="mp-meta-label">Read first: </span>
          {prereqLinks.map(({ handle, title }, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/learn/${handle}/`}>{title}</a>
            </>
          ))}
        </span>
      )}
      {relatedLinks.length > 0 && (
        <span>
          <span class="mp-meta-label">Related: </span>
          {relatedLinks.map(({ handle, title }, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/learn/${handle}/`}>{title}</a>
            </>
          ))}
        </span>
      )}
    </div>
  )
}
