---
/**
 * FIG 18 — IEM: inside the shell, inside the canal (animated: sound
 * exiting the bore). Balanced armatures and a dynamic driver, the
 * crossover, sound bores to the nozzle, and the ear-tip seal in the
 * canal — the seal is the bass.
 */
import { arcPath } from './geometry';

const cy = 240;

const ink = 'var(--mp-charcoal)';
const accent = 'var(--mp-accent)';
const label = 'var(--mp-meta)';
const faint = 'var(--mp-faint)';
const hair = 'var(--mp-hair)';
const ground = 'var(--mp-ground)';
const washInk = 'color-mix(in srgb, var(--mp-charcoal) 8%, transparent)';
const washInkSoft = 'color-mix(in srgb, var(--mp-charcoal) 5%, transparent)';
const washAccent = 'color-mix(in srgb, var(--mp-accent) 7%, transparent)';
---

<svg
  viewBox="0 92 760 368"
  class="mp-dgm"
  role="img"
  aria-label="Cross-section of an in-ear monitor seated in the ear canal: balanced armatures for highs and a dynamic driver for lows inside the shell, a crossover, sound bores running to the nozzle, and the ear-tip flanges sealing the canal"
>
  <line x1="430" y1={cy - 42} x2="700" y2={cy - 56} stroke={ink} stroke-width="1.5"></line>
  <line x1="430" y1={cy + 42} x2="700" y2={cy + 56} stroke={ink} stroke-width="1.5"></line>
  {
    Array.from({ length: 7 }).map((_, k) => {
      const t = k / 6,
        x = 520 + t * 168;
      return (
        <g>
          <line x1={x} y1={cy - 47 - t * 9} x2={x + 9} y2={cy - 56 - t * 9} stroke={faint} stroke-width="1" />
          <line x1={x} y1={cy + 47 + t * 9} x2={x + 9} y2={cy + 56 + t * 9} stroke={faint} stroke-width="1" />
        </g>
      );
    })
  }
  <text x="650" y={cy - 70} font-size="9.5" font-weight="500" fill={label} text-anchor="end">EAR CANAL</text>

  <path
    d={`M 420 ${cy - 36} C 420 ${cy - 96} 350 ${cy - 110} 280 ${cy - 96} C 200 ${cy - 80} 182 ${cy + 30} 240 ${cy + 78} C 300 ${cy + 124} 408 ${cy + 64} 420 ${cy + 36} Z`}
    fill={washInkSoft}
    stroke={ink}
    stroke-width="2"></path>
  <rect x="420" y={cy - 22} width="56" height="44" rx="6" fill={ground} stroke={ink} stroke-width="1.5"></rect>
  <line x1="426" y1={cy} x2="472" y2={cy} stroke={accent} stroke-width="2.5"></line>
  <path
    d={`M 452 ${cy - 22} Q 492 ${cy - 40} 496 ${cy - 4} L 496 ${cy + 4} Q 492 ${cy + 40} 452 ${cy + 22}`}
    fill={washInk}
    stroke={ink}
    stroke-width="1.5"></path>
  <circle cx="350" cy={cy + 18} r="30" fill="none" stroke={ink} stroke-width="1.5"></circle>
  <circle cx="350" cy={cy + 18} r="10" fill={washAccent} stroke={accent} stroke-width="2"></circle>
  <rect x="262" y={cy - 64} width="42" height="26" rx="3" fill="none" stroke={ink} stroke-width="1.5"></rect>
  <rect x="262" y={cy - 28} width="42" height="26" rx="3" fill="none" stroke={ink} stroke-width="1.5"></rect>
  <rect x="236" y={cy + 22} width="34" height="22" rx="3" fill={washInk} stroke={ink} stroke-width="1.5"></rect>
  <path d={`M 304 ${cy - 50} C 370 ${cy - 50} 400 ${cy - 18} 426 ${cy - 6}`} fill="none" stroke={label} stroke-width="1.4"></path>
  <path d={`M 380 ${cy + 16} C 404 ${cy + 12} 414 ${cy + 6} 426 ${cy + 4}`} fill="none" stroke={label} stroke-width="1.4"></path>
  <path d={`M 270 ${cy + 22} C 280 ${cy + 4} 300 ${cy - 6} 320 ${cy - 10}`} fill="none" stroke={hair} stroke-width="1.2" stroke-dasharray="2 3"></path>

  {
    [14, 26].map((r, i) => (
      <path
        class="mp-wave-out2"
        style={i ? 'animation-delay: -1.2s' : undefined}
        d={arcPath(500, cy, r, -50, 50)}
        fill="none"
        stroke={accent}
        stroke-width="1.6"
        opacity={0.7 - i * 0.3}
      />
    ))
  }

  <text x="150" y="108" font-size="9.5" font-weight="500" fill={label}>BALANCED ARMATURES — HIGHS</text>
  <line x1="236" y1="114" x2="282" y2={cy - 56} stroke={faint} stroke-width="1"></line>
  <circle cx="282" cy={cy - 56} r="2.2" fill={faint}></circle>
  <text x="96" y={cy + 116} font-size="9.5" font-weight="500" fill={label}>CROSSOVER</text>
  <line x1="136" y1={cy + 110} x2="248" y2={cy + 40} stroke={faint} stroke-width="1"></line>
  <circle cx="248" cy={cy + 40} r="2.2" fill={faint}></circle>
  <text x="328" y={cy + 106} font-size="9.5" font-weight="500" fill={label}>DYNAMIC DRIVER — LOWS</text>
  <line x1="372" y1={cy + 98} x2="356" y2={cy + 44} stroke={faint} stroke-width="1"></line>
  <circle cx="356" cy={cy + 44} r="2.2" fill={faint}></circle>
  <text x="430" y="120" font-size="9.5" font-weight="500" fill={label}>SOUND BORE</text>
  <line x1="452" y1="126" x2="446" y2={cy - 8} stroke={faint} stroke-width="1"></line>
  <circle cx="446" cy={cy - 8} r="2.2" fill={faint}></circle>
  <text x="556" y="150" font-size="9.5" font-weight="500" fill={label}>EAR-TIP — THE SEAL</text>
  <line x1="566" y1="156" x2="488" y2={cy - 26} stroke={faint} stroke-width="1"></line>
  <circle cx="488" cy={cy - 26} r="2.2" fill={faint}></circle>

  <text x="24" y="446" font-size="10" font-weight="500" fill={label} opacity="0.9"
    >THE SEAL IS THE BASS — A LEAKING TIP COSTS MORE LOW END THAN ANY DRIVER UPGRADE BUYS BACK.</text
  >
</svg>

<style>
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
