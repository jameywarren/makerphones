---
/**
 * FIG 03 — Open back vs closed back (animated: front wave to the
 * ear; rear wave escaping vs reflecting inside the sealed cup).
 */
import { arcPath, arrowHead } from './geometry';

const ink = 'var(--mp-charcoal)';
const accent = 'var(--mp-accent)';
const dark = 'var(--mp-ink)';
const label = 'var(--mp-meta)';
const faint = 'var(--mp-faint)';

const cy = 245,
  R = 130;
const cups = [
  { cx: 230, open: true },
  { cx: 650, open: false },
];
const earArrows = cups.map((c) => arrowHead(c.cx - 185, cy, 180, 6));
---

<svg
  viewBox="0 44 880 396"
  class="mp-dgm"
  role="img"
  aria-label="Open-back cup lets the rear wave escape; closed-back cup isolates but reflects rear energy back toward the driver"
>
  <text x="230" y="68" font-size="12" font-weight="600" fill={dark} text-anchor="middle">OPEN BACK</text>
  <text x="650" y="68" font-size="12" font-weight="600" fill={dark} text-anchor="middle">CLOSED BACK</text>

  {
    cups.map((c, i) => (
      <g>
        <path d={arcPath(c.cx, cy, R, -90, -32)} fill="none" stroke={ink} stroke-width="9" />
        <path d={arcPath(c.cx, cy, R, 32, 90)} fill="none" stroke={ink} stroke-width="9" />
        {c.open ? (
          <path d={arcPath(c.cx, cy, R, -28, 28)} fill="none" stroke={ink} stroke-width="9" stroke-dasharray="13 10" />
        ) : (
          <path d={arcPath(c.cx, cy, R, -32, 32)} fill="none" stroke={ink} stroke-width="9" />
        )}
        <line x1={c.cx} y1="115" x2={c.cx} y2="375" stroke={ink} stroke-width="5" />
        <rect x={c.cx + 3} y={cy - 22} width="15" height="44" fill={dark} />
        <path class="mp-osc-s" d={`M ${c.cx + 1} ${cy - 26} Q ${c.cx - 17} ${cy} ${c.cx + 1} ${cy + 26}`} fill="none" stroke={accent} stroke-width="2.5" />

        <path class="mp-wave-front" d={arcPath(c.cx - 12, cy, 34, 130, 230)} fill="none" stroke={label} stroke-width="1.5" opacity="0.7" />
        <path class="mp-wave-front" style="animation-delay: -0.87s;" d={arcPath(c.cx - 12, cy, 60, 130, 230)} fill="none" stroke={label} stroke-width="1.5" opacity="0.45" />
        <path class="mp-wave-front" style="animation-delay: -1.73s;" d={arcPath(c.cx - 12, cy, 86, 130, 230)} fill="none" stroke={label} stroke-width="1.5" opacity="0.25" />

        {c.open ? (
          <g>
            <path class="mp-wave-out" d={arcPath(c.cx + 12, cy, 34, -48, 48)} fill="none" stroke={accent} stroke-width="1.8" opacity="0.85" />
            <path class="mp-wave-out" style="animation-delay: -0.8s;" d={arcPath(c.cx + 12, cy, 62, -48, 48)} fill="none" stroke={accent} stroke-width="1.8" opacity="0.6" />
            <path class="mp-wave-out" style="animation-delay: -1.6s;" d={arcPath(c.cx + 12, cy, 90, -48, 48)} fill="none" stroke={accent} stroke-width="1.8" opacity="0.4" />
            <path class="mp-wave-out" style="animation-delay: -0.4s;" d={arcPath(c.cx + 12, cy, 152, -24, 24)} fill="none" stroke={accent} stroke-width="1.4" opacity="0.35" />
            <path class="mp-wave-out" style="animation-delay: -1.2s;" d={arcPath(c.cx + 12, cy, 180, -24, 24)} fill="none" stroke={accent} stroke-width="1.4" opacity="0.2" />
          </g>
        ) : (
          <g>
            <path class="mp-wave-out2" d={arcPath(c.cx + 12, cy, 30, -48, 48)} fill="none" stroke={accent} stroke-width="1.8" opacity="0.85" />
            <path class="mp-wave-out2" style="animation-delay: -0.8s;" d={arcPath(c.cx + 12, cy, 56, -48, 48)} fill="none" stroke={accent} stroke-width="1.8" opacity="0.6" />
            <path class="mp-wave-out2" style="animation-delay: -1.6s;" d={arcPath(c.cx + 12, cy, 82, -48, 48)} fill="none" stroke={accent} stroke-width="1.8" opacity="0.4" />
            <path class="mp-wave-back" d={arcPath(c.cx + 150, cy, 44, 132, 228)} fill="none" stroke={accent} stroke-width="1.4" stroke-dasharray="5 4" opacity="0.5" />
            <path class="mp-wave-back" style="animation-delay: -1.3s;" d={arcPath(c.cx + 150, cy, 76, 132, 228)} fill="none" stroke={accent} stroke-width="1.4" stroke-dasharray="5 4" opacity="0.3" />
          </g>
        )}

        <line x1={c.cx - 150} y1={cy} x2={c.cx - 185} y2={cy} stroke={faint} stroke-width="1.2" />
        <polygon points={earArrows[i].points} transform={earArrows[i].transform} fill={faint} />
        <text x={c.cx - 168} y={cy - 14} font-size="9" font-weight="500" fill={label} text-anchor="middle">TO EAR</text>
      </g>
    ))
  }

  <text x="380" y="380" font-size="9.5" font-weight="500" fill={label}>REAR WAVE ESCAPES</text>
  <line x1="390" y1="368" x2="380" y2="310" stroke={faint} stroke-width="1"></line>
  <circle cx="380" cy="310" r="2.2" fill={faint}></circle>
  <text x="710" y="398" font-size="9.5" font-weight="500" fill={label}>REFLECTED INSIDE</text>
  <line x1="730" y1="386" x2="730" y2="290" stroke={faint} stroke-width="1"></line>
  <circle cx="730" cy="290" r="2.2" fill={faint}></circle>
  <text x="230" y="428" font-size="10" font-weight="500" fill={label} opacity="0.9" text-anchor="middle">LESS PRESSURE BUILD-UP · LESS ISOLATION</text>
  <text x="650" y="428" font-size="10" font-weight="500" fill={label} opacity="0.9" text-anchor="middle">ISOLATION — BUT REFLECTIONS RETURN</text>
</svg>

<style>
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
