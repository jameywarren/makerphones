---
/**
 * Hero diagram — exploded headphone assembly. Signature diagram style:
 * charcoal line-art, orange marking the part that matters (the driver).
 * Vector spec from the Claude Design v2 handoff.
 */
---

<svg
  viewBox="0 0 560 500"
  class="mp-exploded"
  role="img"
  aria-label="Exploded diagram of a headphone: headband, cup shell, driver, baffle, and ear pad"
>
  <line x1="280" y1="20" x2="280" y2="488" stroke="var(--mp-line)" stroke-width="1" stroke-dasharray="4 6"></line>
  <path d="M 130 120 Q 280 16 430 120" fill="none" stroke="var(--mp-charcoal)" stroke-width="2"></path>
  <line x1="130" y1="120" x2="130" y2="148" stroke="var(--mp-charcoal)" stroke-width="2"></line>
  <line x1="430" y1="120" x2="430" y2="148" stroke="var(--mp-charcoal)" stroke-width="2"></line>
  <path d="M 200 196 Q 200 168 232 168 L 328 168 Q 360 168 360 196 L 360 230 L 200 230 Z" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.8"></path>
  <circle cx="280" cy="300" r="42" fill="none" stroke="var(--mp-accent)" stroke-width="2"></circle>
  <circle cx="280" cy="300" r="27" fill="none" stroke="var(--mp-accent)" stroke-width="1.3"></circle>
  <circle cx="280" cy="300" r="9" fill="none" stroke="var(--mp-accent)" stroke-width="1.3"></circle>
  <rect x="206" y="376" width="148" height="16" rx="6" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.8"></rect>
  <circle cx="244" cy="384" r="2.5" fill="var(--mp-charcoal)"></circle>
  <circle cx="280" cy="384" r="2.5" fill="var(--mp-charcoal)"></circle>
  <circle cx="316" cy="384" r="2.5" fill="var(--mp-charcoal)"></circle>
  <rect x="194" y="424" width="172" height="38" rx="19" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.8"></rect>
  <rect x="228" y="434" width="104" height="18" rx="9" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.2"></rect>
  <line x1="360" y1="200" x2="442" y2="200" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="448" y="203" class="mp-diagram-label">cup shell</text>
  <line x1="322" y1="300" x2="442" y2="300" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="448" y="296" class="mp-diagram-label is-accent">driver</text>
  <text x="448" y="311" class="mp-diagram-label is-accent">40 mm dynamic</text>
  <line x1="354" y1="384" x2="442" y2="384" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="448" y="387" class="mp-diagram-label">baffle · vented</text>
  <line x1="366" y1="443" x2="442" y2="443" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="448" y="446" class="mp-diagram-label">ear pad</text>
  <line x1="198" y1="68" x2="118" y2="68" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="20" y="71" class="mp-diagram-label">headband</text>
</svg>

<style>
  .mp-exploded {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
