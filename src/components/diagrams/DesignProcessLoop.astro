---
/**
 * FIG 15 — The design process: five phases, one loop. Define →
 * Initial Design → Prototype & Test → Iterate & Refine → Document,
 * with the iterate-back arrow showing where the real work lives.
 */
import { arrowHead } from './geometry';

const phases: [string, string, string][] = [
  ['01', 'DEFINE', 'TARGETS, CONSTRAINTS'],
  ['02', 'INITIAL DESIGN', 'TOPOLOGY, PARTS'],
  ['03', 'PROTOTYPE & TEST', 'BUILD, MEASURE'],
  ['04', 'ITERATE & REFINE', 'TUNE, REMEASURE'],
  ['05', 'DOCUMENT', 'PUBLISH THE RECORD'],
];
const w = 122,
  h = 66,
  gap = 22,
  x0 = 40,
  y = 160;
const x3 = x0 + 2 * (w + gap) + w / 2,
  x4 = x0 + 3 * (w + gap) + w / 2;

const ink = 'var(--mp-charcoal)';
const accent = 'var(--mp-accent)';
const dark = 'var(--mp-ink)';
const label = 'var(--mp-meta)';
const washInkSoft = 'color-mix(in srgb, var(--mp-charcoal) 5%, transparent)';
---

<svg
  viewBox="0 128 760 282"
  class="mp-dgm"
  role="img"
  aria-label="The five-phase design process as a flow: define, initial design, prototype and test, iterate and refine, document — with an iterate-back loop from phase four to phase three"
>
  {
    phases.map(([n, name, sub], i) => {
      const x = x0 + i * (w + gap);
      const head = arrowHead(x + w + gap - 3, y + h / 2, 0, 6);
      return (
        <g>
          <rect x={x} y={y} width={w} height={h} fill={i === 2 || i === 3 ? washInkSoft : 'none'} stroke={ink} stroke-width="1.5" />
          <text x={x + 10} y={y - 10} font-size="9" font-weight="700" fill={accent}>
            {n}
          </text>
          <text x={x + w / 2} y={y + 30} font-size="8.6" font-weight="600" fill={dark} text-anchor="middle">
            {name}
          </text>
          <text x={x + w / 2} y={y + 47} font-size="7.4" font-weight="500" fill={label} text-anchor="middle">
            {sub}
          </text>
          {i < 4 && (
            <g>
              <line x1={x + w + 3} y1={y + h / 2} x2={x + w + gap - 3} y2={y + h / 2} stroke={ink} stroke-width="1.5" />
              <polygon points={head.points} transform={head.transform} fill={ink} />
            </g>
          )}
        </g>
      );
    })
  }
  <path d={`M ${x4} ${y + h} C ${x4} ${y + h + 64} ${x3} ${y + h + 64} ${x3} ${y + h + 10}`} fill="none" stroke={accent} stroke-width="2"></path>
  <polygon points="0,0 -7,3 -7,-3" transform={`translate(${x3} ${y + h + 8}) rotate(-90)`} fill={accent}></polygon>
  <text x={(x3 + x4) / 2} y={y + h + 80} font-size="9" font-weight="600" fill={accent} text-anchor="middle">THE LOOP — EXPECT 3–6 PASSES</text>

  <text x="24" y="396" font-size="10" font-weight="500" fill={label} opacity="0.9"
    >THE LOOP IS THE METHOD — MOST OF THE WORK IS 03 ↔ 04. DOCUMENT LAST, BUT TAKE NOTES THE WHOLE WAY THROUGH.</text
  >
</svg>

<style>
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
