---
/**
 * Driver cutaway — inline chapter figure. Charcoal line-art, orange
 * marks the voice coil. Use inside <figure class="mp-figure"> with an
 * .mp-figcaption for the diagram-system treatment.
 */
---

<svg
  viewBox="0 0 600 240"
  class="mp-driverdiagram"
  role="img"
  aria-label="Cross-section of a dynamic driver: diaphragm, voice coil, magnet, basket, and rear vents"
>
  <rect x="150" y="60" width="300" height="120" rx="10" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.5"></rect>
  <path d="M 160 70 Q 300 38 440 70" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.5"></path>
  <circle cx="160" cy="70" r="3" fill="var(--mp-charcoal)"></circle>
  <circle cx="440" cy="70" r="3" fill="var(--mp-charcoal)"></circle>
  <rect x="282" y="58" width="36" height="34" fill="none" stroke="var(--mp-accent)" stroke-width="1.5"></rect>
  <line x1="282" y1="67" x2="318" y2="67" stroke="var(--mp-accent)" stroke-width="1"></line>
  <line x1="282" y1="76" x2="318" y2="76" stroke="var(--mp-accent)" stroke-width="1"></line>
  <line x1="282" y1="85" x2="318" y2="85" stroke="var(--mp-accent)" stroke-width="1"></line>
  <rect x="240" y="100" width="120" height="56" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.5"></rect>
  <line x1="240" y1="128" x2="360" y2="128" stroke="var(--mp-charcoal)" stroke-width="1" stroke-dasharray="3 3"></line>
  <circle cx="190" cy="170" r="4" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.2"></circle>
  <circle cx="220" cy="170" r="4" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.2"></circle>
  <circle cx="380" cy="170" r="4" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.2"></circle>
  <circle cx="410" cy="170" r="4" fill="none" stroke="var(--mp-charcoal)" stroke-width="1.2"></circle>
  <line x1="300" y1="44" x2="300" y2="24" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="308" y="22" class="mp-diagram-label">diaphragm</text>
  <line x1="318" y1="75" x2="470" y2="40" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="476" y="38" class="mp-diagram-label is-accent">voice coil</text>
  <line x1="360" y1="128" x2="488" y2="128" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="494" y="131" class="mp-diagram-label">magnet</text>
  <line x1="190" y1="176" x2="160" y2="208" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="60" y="218" class="mp-diagram-label">rear vents</text>
  <line x1="150" y1="120" x2="110" y2="120" stroke="var(--mp-line)" stroke-width="1"></line>
  <text x="48" y="123" class="mp-diagram-label">basket</text>
</svg>

<style>
  .mp-driverdiagram {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
