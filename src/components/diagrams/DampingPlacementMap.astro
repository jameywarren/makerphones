---
/**
 * FIG 12 — Damping: the four placement zones (animated: the back
 * wave radiating off the driver). Ear-cup cross-section with rear
 * chamber, driver front, cup walls, and baffle called out, each
 * annotated with its effect.
 */
import Pinna from './Pinna.astro';
import { arcPath } from './geometry';

const bx = 430,
  cy = 250;

const zones = [
  { n: '01', name: 'REAR CHAMBER', fx: 'ABSORBS THE BACK WAVE — KILLS BOXINESS', lx: 60, ly: 130, tx: 300, ty: 196, start: false },
  { n: '02', name: 'DRIVER FRONT', fx: 'FELT DISC — TAMES TREBLE PEAKS', lx: 545, ly: 130, tx: 472, ty: cy - 14, start: true },
  { n: '03', name: 'CUP WALLS', fx: 'MASS + FOAM LINING — STOPS SHELL RING', lx: 60, ly: 390, tx: 252, ty: 330, start: false },
  { n: '04', name: 'BAFFLE', fx: 'SEAL & STIFFEN — STOPS PANEL RING', lx: 545, ly: 390, tx: bx + 9, ty: 330, start: true },
];

const ink = 'var(--mp-charcoal)';
const accent = 'var(--mp-accent)';
const dark = 'var(--mp-ink)';
const label = 'var(--mp-meta)';
const faint = 'var(--mp-faint)';
const hair = 'var(--mp-hair)';
const washInk = 'color-mix(in srgb, var(--mp-charcoal) 8%, transparent)';
const washInkSoft = 'color-mix(in srgb, var(--mp-charcoal) 5%, transparent)';
const washAccent = 'color-mix(in srgb, var(--mp-accent) 7%, transparent)';
---

<svg
  viewBox="0 88 760 372"
  class="mp-dgm"
  role="img"
  aria-label="An ear-cup cross-section with the four damping placement zones called out: the rear chamber absorbing the back wave, a felt disc in front of the driver, mass and foam lining on the cup walls, and a sealed, stiffened baffle"
>
  <path d={`M ${bx} 110 C 240 110 240 390 ${bx} 390`} fill={washInkSoft} stroke={ink} stroke-width="2"></path>
  <path d={`M ${bx - 10} 124 C 262 126 262 374 ${bx - 10} 376`} fill="none" stroke={label} stroke-width="1.2" stroke-dasharray="4 3"></path>
  <rect x={bx} y="104" width="16" height="292" fill={washInk} stroke={ink} stroke-width="1.5"></rect>
  <rect x={bx - 14} y={cy - 34} width="14" height="68" fill="none" stroke={ink} stroke-width="1.5"></rect>
  <path d={`M ${bx + 16} ${cy - 26} A 28 28 0 0 1 ${bx + 16} ${cy + 26}`} fill={washAccent} stroke={accent} stroke-width="2"></path>
  <line x1={bx + 52} y1={cy - 26} x2={bx + 52} y2={cy + 26} stroke={label} stroke-width="2" stroke-dasharray="3 3"></line>
  {
    [-1, 1].map((sg) => (
      <rect x={bx + 16} y={cy + sg * 110 - 30} width="64" height="60" rx="24" fill="none" stroke={ink} stroke-width="1.5" />
    ))
  }
  <line x1={bx + 80} y1="110" x2={bx + 80} y2="390" stroke={hair} stroke-width="1.2"></line>
  <Pinna cx={bx + 52} cy={cy} s={0.92} />

  {
    [26, 46, 66].map((r, i) => (
      <path
        class="mp-wave-front"
        style={i ? `animation-delay: ${-0.87 * i}s` : undefined}
        d={arcPath(bx - 16, cy, r, 128, 232)}
        fill="none"
        stroke={accent}
        stroke-width="1.8"
        opacity={0.7 - i * 0.22}
      />
    ))
  }
  <text x="300" y={cy + 4} font-size="8.5" font-weight="500" fill={label}>BACK WAVE</text>

  {
    zones.map((z) => (
      <g>
        <text x={z.lx} y={z.ly} font-size="10" font-weight="700" fill={accent}>
          {z.n}
        </text>
        <text x={z.lx + 28} y={z.ly} font-size="9.5" font-weight="600" fill={dark}>
          {z.name}
        </text>
        <text x={z.lx} y={z.ly + 15} font-size="8.5" font-weight="500" fill={label}>
          {z.fx}
        </text>
        <line x1={z.start ? z.lx + 4 : z.lx + 30} y1={z.ly + (z.ly < 200 ? 22 : -14)} x2={z.tx} y2={z.ty} stroke={faint} stroke-width="1" />
        <circle cx={z.tx} cy={z.ty} r="2.2" fill={faint} />
      </g>
    ))
  }

  <text x="24" y="446" font-size="10" font-weight="500" fill={label} opacity="0.9"
    >EACH ZONE SOLVES A DIFFERENT PROBLEM — WORK 01 → 04 AND MEASURE AFTER EACH CHANGE.</text
  >
</svg>

<style>
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
