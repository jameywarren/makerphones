---
/**
 * FIG 14 — Form factors: how each one couples to the ear. Over-ear,
 * on-ear, and in-ear as sectional silhouettes against the same ear,
 * with the coupling volume (the air the driver actually sees)
 * highlighted in each.
 */
import Pinna from './Pinna.astro';
import { hatchV } from './geometry';

const cy = 240;
const panels = [
  { x: 130, name: 'OVER-EAR', sub: 'CIRCUMAURAL — SEALS AROUND THE PINNA', note: 'LARGEST CAVITY · MOST STABLE SEAL' },
  { x: 380, name: 'ON-EAR', sub: 'SUPRA-AURAL — RESTS ON THE PINNA', note: 'LEAK-PRONE — CLAMP SETS THE BASS' },
  { x: 630, name: 'IN-EAR', sub: 'INTRA-AURAL — SEALS THE CANAL', note: 'TINY CAVITY · SEAL IS EVERYTHING' },
];

const ink = 'var(--mp-charcoal)';
const accent = 'var(--mp-accent)';
const dark = 'var(--mp-ink)';
const label = 'var(--mp-meta)';
const faint = 'var(--mp-faint)';
const hair = 'var(--mp-hair)';
const washInkSoft = 'color-mix(in srgb, var(--mp-charcoal) 5%, transparent)';
const washAccent = 'color-mix(in srgb, var(--mp-accent) 7%, transparent)';
---

<svg
  viewBox="0 72 760 388"
  class="mp-dgm"
  role="img"
  aria-label="Over-ear, on-ear, and in-ear headphones drawn in section against the same ear, with the coupling volume each driver sees highlighted: largest and most stable around the ear, leak-prone on the ear, and tiny but sealed in the canal"
>
  {
    panels.map((p, i) => (
      <g>
        <line x1={p.x + 26} y1={cy - 110} x2={p.x + 26} y2={cy + 110} stroke={hair} stroke-width="1.2" />
        {hatchV(p.x + 26, cy - 100, cy + 100, 1, 7, 7).map((l) => (
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={faint} stroke-width="1" />
        ))}
        <Pinna cx={p.x} cy={cy} s={1} />

        {i === 0 && (
          <g>
            <path
              d={`M ${p.x + 24} ${cy - 78} C ${p.x - 110} ${cy - 78} ${p.x - 110} ${cy + 78} ${p.x + 24} ${cy + 78}`}
              fill="none"
              stroke={ink}
              stroke-width="2"
            />
            {[-1, 1].map((sg) => (
              <rect
                x={p.x - 6}
                y={cy + sg * 62 - 12}
                width="30"
                height="24"
                rx="10"
                fill={washInkSoft}
                stroke={ink}
                stroke-width="1.5"
                transform={`rotate(${sg * 4} ${p.x + 8} ${cy + sg * 62})`}
              />
            ))}
            <rect x={p.x - 44} y={cy - 50} width="30" height="100" rx="4" fill={washAccent} opacity="0.85" />
          </g>
        )}
        {i === 1 && (
          <g>
            <path
              d={`M ${p.x - 4} ${cy - 52} C ${p.x - 88} ${cy - 52} ${p.x - 88} ${cy + 52} ${p.x - 4} ${cy + 52}`}
              fill="none"
              stroke={ink}
              stroke-width="2"
            />
            <rect x={p.x - 18} y={cy - 44} width="22" height="88" rx="11" fill={washInkSoft} stroke={ink} stroke-width="1.5" />
            <rect x={p.x - 2} y={cy - 30} width="14" height="60" rx="4" fill={washAccent} opacity="0.85" />
          </g>
        )}
        {i === 2 && (
          <g>
            <path
              d={`M ${p.x - 36} ${cy - 18} C ${p.x - 58} ${cy - 24} ${p.x - 58} ${cy + 24} ${p.x - 36} ${cy + 18} Z`}
              fill={washInkSoft}
              stroke={ink}
              stroke-width="1.5"
            />
            <rect x={p.x - 36} y={cy - 9} width="26" height="18" rx="4" fill="none" stroke={ink} stroke-width="1.5" />
            <path
              d={`M ${p.x - 12} ${cy - 13} Q ${p.x + 4} ${cy - 13} ${p.x + 6} ${cy - 4} L ${p.x + 6} ${cy + 4} Q ${p.x + 4} ${cy + 13} ${p.x - 12} ${cy + 13}`}
              fill={washInkSoft}
              stroke={ink}
              stroke-width="1.2"
            />
            <rect x={p.x + 6} y={cy - 4} width="18" height="8" fill={washAccent} />
          </g>
        )}

        <text x={p.x - 20} y={cy + 150} font-size="10" font-weight="600" fill={dark} text-anchor="middle">
          {p.name}
        </text>
        <text x={p.x - 20} y={cy + 166} font-size="8" font-weight="500" fill={label} text-anchor="middle">
          {p.sub}
        </text>
        <text x={p.x - 20} y={cy + 184} font-size="8" font-weight="600" fill={accent} text-anchor="middle">
          {p.note}
        </text>
      </g>
    ))
  }
  <rect x="24" y="88" width="12" height="12" fill={washAccent}></rect>
  <text x="44" y="98" font-size="8.5" font-weight="500" fill={label}>COUPLING VOLUME — THE AIR THE DRIVER ACTUALLY SEES</text>

  <text x="24" y="446" font-size="10" font-weight="500" fill={label} opacity="0.9"
    >SAME DRIVER, THREE INSTRUMENTS — THE COUPLING VOLUME, AND HOW IT SEALS, IS THE FORM FACTOR.</text
  >
</svg>

<style>
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
