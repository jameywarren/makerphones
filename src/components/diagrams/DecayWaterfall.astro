---
/**
 * FIG 06 — Energy decay over time / CSD waterfall (animated: decay
 * pulse travelling back through the time slices). The resonance
 * ridge (orange) keeps ringing while everything else decays fast.
 */
import { arrowHead } from './geometry';

interface Props {
  dense?: boolean;
}
const { dense = false } = Astro.props;

const x0 = 110,
  W = 520,
  y0 = 395,
  H = 125;
const N = dense ? 14 : 9,
  dx = dense ? 9 : 13,
  dy = dense ? 16.5 : 24;
const decayK = dense ? 0.38 : 0.55,
  ringK = dense ? 0.07 : 0.1;

const base = (f: number) => 0.42 + 0.16 * Math.cos(3.2 * f + 0.6) + 0.1 * Math.cos(8.5 * f + 1.8);
const gauss = (f: number) => Math.exp(-Math.pow(f - 0.62, 2) / (2 * 0.035 * 0.035));
const lvl = (f: number, i: number) =>
  base(f) * Math.exp(-i * decayK) + 0.9 * gauss(f) * 0.95 * Math.exp(-i * ringK);

const slices: { d: string; front: boolean; delay: string }[] = [];
for (let i = N - 1; i >= 0; i--) {
  const bx = x0 + i * dx;
  const by = y0 - i * dy;
  const pts: string[] = [];
  for (let f = 0; f <= 1.0001; f += 0.01) {
    pts.push(`${(bx + f * W).toFixed(1)} ${(by - H * lvl(f, i)).toFixed(1)}`);
  }
  slices.push({
    d: `M ${bx} ${by} L ` + pts.join(' L ') + ` L ${bx + W} ${by} Z`,
    front: i === 0,
    delay: `${(i * (4.2 / N) - 4.2).toFixed(2)}s`,
  });
}

const ridgePts: [number, number][] = [];
for (let i = 0; i < N; i++) {
  ridgePts.push([x0 + i * dx + 0.62 * W, y0 - i * dy - H * lvl(0.62, i)]);
}

const ink = 'var(--mp-charcoal)';
const accent = 'var(--mp-accent)';
const label = 'var(--mp-meta)';
const faint = 'var(--mp-faint)';
const ground = 'var(--mp-surface)';

const timeArr = arrowHead(x0 + W + 14 + (N - 1) * dx, y0 - 6 - (N - 1) * dy, -61.6, 6);
---

<svg
  viewBox="0 44 760 426"
  class="mp-dgm"
  role="img"
  aria-label="A waterfall plot of energy decay: stacked frequency-response slices over time, with one resonance ridge that keeps ringing"
>
  {
    slices.map((s) => (
      <path
        d={s.d}
        fill={ground}
        stroke={ink}
        stroke-width={s.front ? 2 : dense ? 1 : 1.1}
        class={s.front ? undefined : 'csd-slice'}
        style={s.front ? undefined : `animation-delay: ${s.delay};`}
        opacity={s.front ? 1 : dense ? 0.92 : 0.9}
      />
    ))
  }
  <polyline points={ridgePts.map((p) => p.join(',')).join(' ')} fill="none" stroke={accent} stroke-width="2"></polyline>
  {ridgePts.map((p) => <circle cx={p[0]} cy={p[1]} r={dense ? 1.7 : 2.2} fill={accent} />)}

  <line x1={x0} y1={y0} x2={x0 + W} y2={y0} stroke={ink} stroke-width="1.5"></line>
  <text x={x0} y={y0 + 24} font-size="9" font-weight="500" fill={label}>20 Hz</text>
  <text x={x0 + W / 2} y={y0 + 24} font-size="9.5" font-weight="500" fill={label} text-anchor="middle">FREQUENCY →</text>
  <text x={x0 + W} y={y0 + 24} font-size="9" font-weight="500" fill={label} text-anchor="end">20 kHz</text>
  <line x1={x0 + W + 14} y1={y0 - 6} x2={x0 + W + 14 + (N - 1) * dx} y2={y0 - 6 - (N - 1) * dy} stroke={faint} stroke-width="1.2"></line>
  <polygon points={timeArr.points} transform={timeArr.transform} fill={faint}></polygon>
  <text x="0" y="0" font-size="9" font-weight="500" fill={label} text-anchor="middle" transform={`translate(${x0 + W + 34} ${y0 - 104}) rotate(-61.6)`}>TIME (ms)</text>

  <text x="446" y="118" font-size="9.5" font-weight="500" fill={label}>RESONANCE — KEEPS RINGING</text>
  <line x1="520" y1="126" x2="536" y2="148" stroke={faint} stroke-width="1"></line>
  <circle cx="536" cy="148" r="2.2" fill={faint}></circle>
  <text x="140" y="150" font-size="9.5" font-weight="500" fill={label}>CLEAN, FAST DECAY</text>
  <line x1="210" y1="158" x2="290" y2="194" stroke={faint} stroke-width="1"></line>
  <circle cx="290" cy="194" r="2.2" fill={faint}></circle>

  <text x="24" y="452" font-size="10" font-weight="500" fill={label} opacity="0.9">{dense ? 'FINER TIME SLICES — THE RESONANT RIDGE READS AS A CONTINUOUS WALL OF STORED ENERGY' : 'EACH SLICE IS THE RESPONSE A FEW MS AFTER THE SIGNAL STOPS — GOOD DAMPING DROPS FAST AT EVERY FREQUENCY'}</text>
</svg>

<style>
  svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
