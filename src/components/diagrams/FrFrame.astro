---
/**
 * Shared log-frequency axis frame for the response figures (FIG 09 /
 * 10): ink axes, faint ticks at the standard decade points, optional
 * dB scale on the left. Renders bare SVG elements — use inside an
 * <svg class="mp-dgm">.
 */
import { lgx, FR_TICKS } from './geometry';

interface Props {
  x0: number;
  y0: number;
  W: number;
  H: number;
  dbTicks?: number[] | null;
  pxPerDb?: number;
  yZero?: number;
}
const { x0, y0, W, H, dbTicks = null, pxPerDb = 0, yZero = 0 } = Astro.props;

const ink = 'var(--mp-charcoal)';
const label = 'var(--mp-meta)';
const faint = 'var(--mp-faint)';
---

<line x1={x0} y1={y0} x2={x0 + W} y2={y0} stroke={ink} stroke-width="1.5"></line>
<line x1={x0} y1={y0} x2={x0} y2={y0 - H} stroke={ink} stroke-width="1.5"></line>
{
  FR_TICKS.map(([f, lab]) => (
    <g>
      <line x1={lgx(f, x0, W)} y1={y0} x2={lgx(f, x0, W)} y2={y0 + 5} stroke={faint} stroke-width="1" />
      <text x={lgx(f, x0, W)} y={y0 + 20} font-size="8.5" font-weight="500" fill={label} text-anchor="middle">
        {lab}
      </text>
    </g>
  ))
}
{
  dbTicks &&
    dbTicks.map((db) => (
      <g>
        <line x1={x0 - 5} y1={yZero - db * pxPerDb} x2={x0} y2={yZero - db * pxPerDb} stroke={faint} stroke-width="1" />
        <text x={x0 - 10} y={yZero - db * pxPerDb + 3.5} font-size="8.5" font-weight="500" fill={label} text-anchor="end">
          {db > 0 ? `+${db}` : db}
        </text>
      </g>
    ))
}
<text x={x0 + W / 2} y={y0 + 38} font-size="9" font-weight="500" fill={label} text-anchor="middle">FREQUENCY (Hz) — LOG</text>
