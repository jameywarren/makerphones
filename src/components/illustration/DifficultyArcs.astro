---
/** Difficulty mark — dot + three radiating arcs; `level` of them active. */
import { arcPath } from '../diagrams/geometry';

interface Props {
  level?: number;
  size?: number;
}
const { level = 1, size = 22 } = Astro.props;
const c = 'var(--mp-charcoal)';
const d = 'var(--mp-hair)';
---

<svg viewBox="0 0 24 24" width={size} height={size} class="mp-diff" aria-label={`difficulty ${level} of 3`} role="img">
  <circle cx="5" cy="19" r="1.8" fill={c}></circle>
  {[1, 2, 3].map((k) => (
    <path d={arcPath(5, 19, 4.5 + k * 4.3, -78, -8)} fill="none" stroke={k <= level ? c : d} stroke-width={k <= level ? 1.8 : 1.2} stroke-linecap="round" />
  ))}
</svg>

<style>
  .mp-diff {
    display: block;
    flex: none;
  }
</style>
