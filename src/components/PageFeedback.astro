---
/**
 * "Suggest an edit" box at the foot of every chapter, appendix, build
 * guide and spec page. No backend and no third-party key: the button
 * opens the reader's own email with the page title and URL filled in,
 * the same handoff /request uses. (The earlier Web3Forms version shipped
 * with a placeholder key and never delivered a message.)
 */
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const TO = 'jamey@jameywarren.com';
const subject = `makerphones feedback: ${title}`;
const body = `Page: ${url}\n\nWhat should change, or what's unclear?\n\n`;
const href = `mailto:${TO}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<aside class="mp-feedback not-content">
  <span class="mp-fb-eyebrow">Suggest an edit or ask about this page</span>
  <p class="mp-fb-hint">Spotted an error, something unclear, or a question the page doesn't answer? It goes straight to the bench.</p>
  <a class="mp-fb-send" href={href}>Email a note about this page</a>
  <p class="mp-fb-alt">Opens your email with this page already named. Or write to <a href={`mailto:${TO}`}>{TO}</a>.</p>
</aside>

<style>
  .mp-feedback {
    margin-top: 3rem;
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1px solid var(--mp-line);
    background: color-mix(in srgb, var(--mp-charcoal) 3%, transparent);
  }
  .mp-fb-eyebrow {
    display: block;
    font-family: var(--mp-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mp-accent);
  }
  .mp-fb-hint {
    font-family: var(--mp-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--mp-meta);
    margin: 0.5rem 0 0.9rem;
  }
  .mp-fb-send {
    display: inline-block;
    text-decoration: none;
    font-family: var(--mp-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mp-bg);
    background: var(--mp-btn-bg, var(--mp-accent));
    padding: 10px 22px;
  }
  .mp-fb-send:hover {
    background: var(--mp-btn-bg-hover, var(--mp-accent-hover));
  }
  .mp-fb-send:focus-visible {
    outline: 2px solid var(--mp-accent);
    outline-offset: 2px;
  }
  .mp-fb-alt {
    font-family: var(--mp-body);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--mp-meta);
    margin: 0.8rem 0 0;
  }
  .mp-fb-alt a {
    color: inherit;
  }
</style>
