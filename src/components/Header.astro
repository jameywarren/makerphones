---
/**
 * Site header — Starlight chrome (brand, search, theme toggle) plus
 * the field-manual nav: The Manual / Bench Notes / Builds / About /
 * V2 · Open Manual. Reading-progress bar on chapter pages.
 */
import SiteTitle from './SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const { id } = Astro.locals.starlightRoute;
const isChapter = id.startsWith('learn/') && id !== 'learn';
const path = Astro.url.pathname;

const NAV = [
  { label: 'The Manual', href: '/contents/' },
  { label: 'Bench Notes', href: '/bench-notes/' },
  { label: 'Builds', href: '/contents/#build-guides' },
  { label: 'About', href: '/about/' },
];
const current = (href: string) => path === href ? 'page' : undefined;
---

<div class="mp-header sl-flex">
  <SiteTitle />
  <nav class="mp-hnav" aria-label="Main">
    {NAV.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
  </nav>
  <div class="mp-header-tools sl-flex">
    <Search />
    <span class="mp-hver">V2 · Open Manual</span>
    <ThemeSelect />
  </div>
</div>
{
  isChapter && (
    <div class="mp-progress" aria-hidden="true">
      <span class="mp-progress-fill" id="mp-progress-fill" />
    </div>
  )
}

<script>
  const fill = document.getElementById('mp-progress-fill');
  if (fill) {
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const pct = max > 0 ? (doc.scrollTop / max) * 100 : 0;
      fill.style.width = pct.toFixed(1) + '%';
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  .mp-header {
    gap: var(--sl-nav-gap, 1rem);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .mp-header-tools {
    gap: 0.75rem;
    align-items: center;
  }
</style>
