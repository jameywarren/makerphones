---
/** Wordmark: charcoal mark with orange dot + MAKER PHONES. */
const href = '/';
---

<a {href} class="site-title sl-flex">
  <span class="mp-mark" aria-hidden="true"><span class="mp-mark-dot"></span></span>
  <span class="mp-wordmark">MAKER&nbsp;PHONES</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 10px;
    text-decoration: none;
    min-width: 0;
  }
  .mp-mark {
    width: 20px;
    height: 20px;
    border-radius: 4.4px;
    background: #2d3748;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .mp-mark-dot {
    width: 8.4px;
    height: 8.4px;
    border-radius: 50%;
    background: #ea580c;
    display: block;
  }
</style>
