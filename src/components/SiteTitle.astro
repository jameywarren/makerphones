---
/** Brand: orange square mark + MakerPhones wordmark (homepage handoff). */
const href = '/';
---

<a {href} class="site-title sl-flex">
  <span class="mp-mark" aria-hidden="true"></span>
  <span class="mp-wordmark">MakerPhones</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 11px;
    text-decoration: none;
    min-width: 0;
    flex: none;
  }
  .mp-mark {
    width: 10px;
    height: 10px;
    background: var(--mp-accent, #ea580c);
    display: block;
    flex: none;
  }
  .mp-wordmark {
    font-family: var(--mp-sans);
    font-weight: 700;
    font-size: 17.5px;
    color: var(--mp-ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
