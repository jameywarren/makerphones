---
/**
 * Brand: horizontal lockup from the logo handoff (_source/logo-final)
 * — driver mark + lowercase wordmark with the terminal leader dot.
 * Spec ratios for wordmark size S: mark 1.18×S, gap 0.42×S; wordmark
 * Schibsted Grotesk 700, -0.03em tracking; dot 0.115em in
 * --mp-accent, 0.09em gap, on the baseline. The rendered wordmark is
 * lowercase "makerphones" — the brand name is styled lowercase, one
 * word, everywhere it appears.
 */
import DriverMark from './illustration/DriverMark.astro';

const href = '/';
---

<div class="mp-brand">
  <a {href} class="site-title sl-flex">
    <DriverMark size={22} />
    <span class="mp-wordmark">makerphones<span class="mp-wordmark-dot" aria-hidden="true"></span></span>
  </a>
  <span class="mp-brand-tagline">Build your own sound</span>
</div>

<style>
  /* Brand column: the home-linked lockup with the "Build your own sound"
   * tagline tucked under the wordmark. Muted mono micro-type so it never
   * competes with the wordmark, and deliberately not a link so it can't be
   * mistaken for the home click target. */
  .mp-brand {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: none;
  }
  .site-title {
    align-items: center;
    gap: 8px; /* 0.42 × wordmark size (19px) per the lockup spec */
    text-decoration: none;
    min-width: 0;
    flex: none;
    color: var(--mp-charcoal);
  }
  .mp-brand-tagline {
    margin-left: 30px; /* align under the wordmark: mark 22px + 8px gap */
    font-family: var(--mp-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mp-meta);
    line-height: 1;
    white-space: nowrap;
  }
  .mp-wordmark {
    font-family: var(--mp-sans);
    font-weight: 700;
    font-size: 1.1875rem;
    color: var(--mp-charcoal);
    letter-spacing: -0.03em;
    white-space: nowrap;
    line-height: 1;
  }
  .mp-wordmark-dot {
    width: 0.115em;
    height: 0.115em;
    border-radius: 50%;
    background: var(--mp-accent);
    display: inline-block;
    margin-left: 0.09em;
  }
</style>
