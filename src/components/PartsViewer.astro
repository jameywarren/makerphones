---
/**
 * Interactive Daily Driver parts viewer (three.js). Loads the published assembly
 * GLB + sub-assembly manifest cross-origin from the daily-driver repo's GitHub
 * Pages (single source — nothing copied on-site). Explode/collapse, sub-assembly
 * toggles, and click-to-isolate are all runtime (see ./parts-viewer.js).
 */
interface Props {
  glb?: string;
  groups?: string;
}
const {
  glb = 'https://makerphones.github.io/daily-driver/models/daily-driver.glb',
  groups = 'https://makerphones.github.io/daily-driver/models/daily-driver.groups.json',
} = Astro.props;
---

<div class="parts-viewer not-content" data-glb={glb} data-groups={groups}>
  <div class="pv-stage">
    <canvas data-pv-canvas></canvas>
    <p class="pv-status" data-pv-status aria-live="polite">Scroll into view to load · drag to orbit</p>
  </div>
  <div class="pv-controls">
    <label class="pv-explode-row">
      <span>Assembled&nbsp;↔&nbsp;Exploded</span>
      <input type="range" min="0" max="1" step="0.001" value="0" data-pv-explode aria-label="Explode the assembly" />
    </label>
    <div class="pv-groups" data-pv-groups aria-label="Show or hide sub-assemblies"></div>
    <button type="button" class="pv-reset" data-pv-reset>Reset view</button>
    <p class="pv-hint">Drag to orbit · scroll to zoom · click a part to isolate it · slide to pull it apart</p>
  </div>
</div>

<script>
  import { initPartsViewer } from './parts-viewer.js';
  const boot = () => document.querySelectorAll('.parts-viewer').forEach((el) => initPartsViewer(el));
  if (document.readyState !== 'loading') boot();
  else document.addEventListener('DOMContentLoaded', boot);
</script>

<style>
  .parts-viewer { display: grid; gap: 0.75rem; margin: 1.75rem 0; }
  /* Hardcoded neutral studio backdrop (like the spec-page teaser) so the charcoal
     parts always read, in light or dark site themes. */
  .pv-stage {
    position: relative; width: 100%; height: 460px;
    background: #f7f7f5; border: 1px solid #e4e4df; border-left: 4px solid #ea580c;
    border-radius: 10px; overflow: hidden;
  }
  .pv-stage canvas { width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
  .pv-stage canvas:active { cursor: grabbing; }
  .pv-status { position: absolute; left: 0.8rem; bottom: 0.55rem; margin: 0; font-size: 0.8rem; color: #5b6573; pointer-events: none; }
  .pv-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.2rem; }
  .pv-explode-row { display: flex; align-items: center; gap: 0.6rem; flex: 1 1 280px; font-size: 0.85rem; }
  .pv-explode-row input[type='range'] { flex: 1; accent-color: #ea580c; }
  .pv-groups { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .pv-toggle { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; padding: 0.2rem 0.55rem; border: 1px solid var(--sl-color-gray-5); border-radius: 6px; cursor: pointer; }
  .pv-toggle input, .pv-groups input { accent-color: #ea580c; }
  .pv-reset { font-size: 0.8rem; padding: 0.3rem 0.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
  .pv-reset:hover { border-color: #ea580c; }
  .pv-hint { flex-basis: 100%; margin: 0; font-size: 0.78rem; color: var(--sl-color-gray-3); }
</style>
