---
/**
 * Contents page body — the real 30-chapter outline. Six parts,
 * decimal nav numbers, difficulty + read time from frontmatter for
 * the 13 written chapters; the rest render as upcoming (dimmed,
 * unlinked — no difficulty/read time invented for unwritten work).
 */
import { getManual } from '../data/manual';
import Level from './Level.astro';
import MpIcon from './illustration/MpIcon.astro';
import { PART_ICONS } from './illustration/icon-map';

const { parts, appendices, buildGuides } = await getManual();
const liveAppendices = appendices.filter((a) => a.written);
const liveGuides = buildGuides.filter((b) => b.written);
---

<div class="mp-contents">
  {
    parts.map((p) => (
      <section class="mp-contents-part" id={`part-${p.num}`}>
        <header class="mp-contents-head">
          <span class="mp-head-eyebrow">
            <MpIcon name={PART_ICONS[p.num]} size={20} />
            <span class="mp-partnum">PART {String(p.num).padStart(2, '0')}</span>
          </span>
          <h2>{p.title}</h2>
          <p>{p.desc}</p>
          <span class="mp-meta">{p.chapters.length} chapters · {p.level}</span>
        </header>
        <div class="mp-contents-rows">
          {p.chapters.map((c, ci) =>
            c.written ? (
              <a class="mp-chapter-row" href={`/learn/${c.handle}/`}>
                <span class="mp-partnum">{c.num}</span>
                <span class="mp-row-main">
                  <span class="mp-row-title">{c.title}</span>
                  {p.num === 1 && ci === 0 && <span class="mp-start-tag">Start here</span>}
                </span>
                <span class="mp-row-level"><Level level={c.difficulty} /></span>
                <span class="mp-meta mp-row-mins">{c.readTime} min</span>
              </a>
            ) : (
              <div class="mp-chapter-row is-upcoming">
                <span class="mp-meta" style="opacity: 0.7;">{c.num}</span>
                <span class="mp-row-main">
                  <span class="mp-row-title">{c.title}</span>
                </span>
                <span class="mp-row-level" />
                <span class="mp-row-mins"><span class="mp-soon">upcoming</span></span>
              </div>
            )
          )}
        </div>
      </section>
    ))
  }
  {
    liveGuides.length > 0 && (
      <section class="mp-contents-part" id="build-guides">
        <header class="mp-contents-head">
          <span class="mp-head-eyebrow">
            <MpIcon name="guide" size={20} />
            <span class="mp-partnum">BUILD GUIDES</span>
          </span>
          <h2>Build something</h2>
          <p>
            Complete, hands-on builds that put the chapters into practice — parts lists, steps,
            and what to expect when it doesn't go to plan.
          </p>
          <span class="mp-meta">{liveGuides.length} guides</span>
        </header>
        <div class="mp-contents-rows">
          {liveGuides.map((b) => (
            <a class="mp-chapter-row" href={`/learn/${b.handle}/`}>
              <span class="mp-partnum">B</span>
              <span class="mp-row-main">
                <span class="mp-row-title">{b.title}</span>
              </span>
              <span class="mp-row-level">{b.difficulty && <Level level={b.difficulty} />}</span>
              <span class="mp-meta mp-row-mins">{b.timeEstimate ?? 'guide'}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
  {
    liveAppendices.length > 0 && (
      <section class="mp-contents-part" id="appendices">
        <header class="mp-contents-head">
          <span class="mp-head-eyebrow">
            <MpIcon name="contents" size={20} />
            <span class="mp-partnum">APPENDICES</span>
          </span>
          <h2>Reference</h2>
          <p>
            Look-up material that supports every chapter: terms, suppliers, tools, fixes, and
            builds from the community.
          </p>
          <span class="mp-meta">{liveAppendices.length} appendices</span>
        </header>
        <div class="mp-contents-rows">
          {liveAppendices.map((a) => (
            <a class="mp-chapter-row" href={`/learn/${a.handle}/`}>
              <span class="mp-partnum">A</span>
              <span class="mp-row-main">
                <span class="mp-row-title">{a.title}</span>
              </span>
              <span class="mp-row-level">{a.difficulty && <Level level={a.difficulty} />}</span>
              <span class="mp-meta mp-row-mins">{a.readTime ? `${a.readTime} min` : 'reference'}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</div>

<style>
  .mp-contents {
    display: grid;
    gap: 3.5rem;
    /* the column is full-width on this route; keep the list at a reading measure */
    padding: 3.5rem clamp(1.25rem, 4vw, 4rem) 1rem;
    max-width: 64rem;
    margin-inline: auto;
  }
  .mp-contents-rows {
    border-top: 1px solid var(--mp-line);
  }
  .mp-row-main {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .mp-contents-part {
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
  }
  .mp-head-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>
