---
/**
 * PageFrame override — mirrors Starlight's default page wrapper
 * (header + sidebar + main-frame) and appends the shared SiteFooter as
 * the last child of .page, after .main-frame.
 *
 * Rendering the footer here (rather than in the Footer slot, which is
 * trapped inside the content column) makes it a true full-width band
 * below both the content and the fixed sidebar — the same treatment as
 * the homepage — without a viewport breakout. The footer wrapper takes
 * the same inline-start inset as .main-frame so it clears the fixed
 * sidebar: --sl-content-inline-start is the sidebar width on doc pages
 * (≥50em) and unset → 0 on the splash homepage and mobile, so the band
 * spans the full viewport there.
 *
 * Synced from @astrojs/starlight PageFrame.astro — re-check on upgrade.
 */
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import SiteFooter from './SiteFooter.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
  <div class="site-footer-frame"><SiteFooter /></div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded='true']) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: '';
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    /* Full-bleed footer band, pinned to the bottom of the page below
     * the content, the left sidebar, and the right TOC. The sidebar is
     * position:fixed (z-index 5) and pinned to the viewport bottom, so
     * the band must paint OVER it: full viewport width, opaque page-bg
     * fill, and a higher z-index. margin-top:auto pins it to the bottom
     * on short pages (where the sidebar is taller than the content) via
     * the .page flex column. Inner content aligns to the header
     * container — see SiteFooter's --sl-nav-pad-x padding — so the logo
     * sits directly beneath the header logo and the nav at the edge. */
    .site-footer-frame {
      margin-top: auto;
      position: relative;
      z-index: calc(var(--sl-z-index-menu) + 1);
      background-color: var(--sl-color-bg);
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }
      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }
    }
  }
</style>
